# AgentFi Environment Configuration
# Copy this file to .env and fill in your values if you have an OpenAI key.
# Note: The system will operate with keyword routing even without an OpenAI key.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# Data directories (relative to project root)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ==============================================================================
# Backend & Database Configuration (Member 2 - FastAPI & Supabase)
# NOTE: Connect directly via PostgreSQL session pooler. NEVER use or commit
# SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY!
# ==============================================================================
APP_NAME="AgentFi API"
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api

# Supabase Session Pooler URL (IPv4, Port 5432). Password MUST be URL-encoded if it contains special chars!
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
USE_TRANSACTION_POOLER=false
DB_POOL_SIZE=5

# JWT Authentication (generate a secure random 64-char string for production)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_SECRET_KEY_PLACEHOLDER_64CHARS_MINIMUM_SECURITY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated URLs for frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Integration Placeholders (Mock / SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=placeholder_email_user
EMAIL_PASSWORD=placeholder_email_password
EMAIL_FROM=no-reply@agentfi.local

